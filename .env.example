APP_NAME=FoodInsightAI V2
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./foodinsightai.db
MAX_UPLOAD_SIZE_MB=10
USDA_API_KEY=
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
\n# Optional food classifier artifacts (model training is a separate phase)
RECOGNITION_MODEL_PATH=artifacts/food_classifier.ts
RECOGNITION_LABELS_PATH=artifacts/classes.json
RECOGNITION_MODEL_VERSION=untrained
RECOGNITION_CONFIDENCE_THRESHOLD=0.65
RECOGNITION_IMAGE_SIZE=224
UPLOAD_DIRECTORY=storage/uploads
